<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:tools="http://schemas.android.com/tools">



  <uses-permission android:name="android.permission.INTERNET" />

  <uses-permission android:name="android.permission.CAMERA" />

  <uses-permission android:name="android.permission.USE_BIOMETRIC" />

  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Android 11+ 패키지 가시성: 설치된 은행·증권 앱 조회 -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
    <!-- 엑셀/PDF 공유·열기 대상 앱 조회 (grantUriPermission용) -->
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </intent>
    <intent>
      <action android:name="android.intent.action.SEND" />
      <data android:mimeType="application/pdf" />
    </intent>
    <intent>
      <action android:name="android.intent.action.VIEW" />
      <data android:mimeType="application/pdf" />
    </intent>
    <package android:name="viva.republica.toss" />
    <package android:name="com.shinhan.sbanking" />
    <package android:name="nh.smart.banking" />
    <package android:name="nh.smart.nhallonepay" />
    <package android:name="com.kbstar.kbank" />
    <package android:name="com.kakaobank.channel" />
    <package android:name="com.wooribank.smart.npib" />
    <package android:name="com.kebhana.hanapush" />
    <package android:name="com.ibk.android.ionebank" />
    <package android:name="com.scbank.ma30" />
    <package android:name="kr.co.citibank.citimobile" />
    <package android:name="com.kbankwith.smartbank" />
    <package android:name="com.kakaopay.app" />
    <package android:name="kr.co.samsungcard.mpocket" />
    <package android:name="com.hyundaicard.appcard" />
    <package android:name="com.lcacApp" />
    <package android:name="com.shcard.smartpay" />
    <package android:name="com.kbcard.cxh.appcard" />
    <package android:name="com.nhcard.nhallonepay" />
    <package android:name="com.kfcc.mobilebank" />
    <package android:name="com.suhyupbank.mobilebank" />
    <package android:name="kr.co.cu.moneyplus" />
    <package android:name="com.oksavingsbank.app" />
    <package android:name="com.miraeasset.trade" />
    <package android:name="com.samsungsecurities.android" />
    <package android:name="com.kiwoom.hero" />
    <package android:name="com.truefriend.neosmartarene" />
    <package android:name="com.nhqv" />
    <package android:name="com.dgb.mobilebank" />
    <package android:name="com.bnkbusanbank.mobilebank" />
    <package android:name="com.kjbank.mobilebank" />
    <package android:name="com.jbbank.mobilebank" />
    <package android:name="com.epost.psf.sdsi" />
  </queries>

  <application

      android:name=".SmartExpenseApplication"

      android:allowBackup="false"

      android:icon="@mipmap/ic_launcher"

      android:label="@string/app_name"

      android:networkSecurityConfig="@xml/network_security_config"

      android:roundIcon="@mipmap/ic_launcher_round"

      android:supportsRtl="true"

      android:theme="@style/Theme.SmartExpense"

      android:usesCleartextTraffic="true"

      tools:targetApi="34">



    <activity

        android:name=".MainActivity"

        android:exported="true"

        android:theme="@style/Theme.App.Starting"

        android:windowSoftInputMode="adjustResize"

        android:importantForAutofill="yes"

        android:hardwareAccelerated="true">

      <intent-filter>

        <action android:name="android.intent.action.MAIN" />

        <category android:name="android.intent.category.LAUNCHER" />

      </intent-filter>

      <meta-data
          android:name="android.app.shortcuts"
          android:resource="@xml/shortcuts" />

    </activity>



    <service

        android:name=".service.bank.BankNotificationListenerService"

        android:exported="true"

        android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">

      <intent-filter>

        <action android:name="android.service.notification.NotificationListenerService" />

      </intent-filter>

    </service>



    <provider

        android:name="androidx.core.content.FileProvider"

        android:authorities="${applicationId}.fileprovider"

        android:exported="false"

        android:grantUriPermissions="true">

      <meta-data

          android:name="android.support.FILE_PROVIDER_PATHS"

          android:resource="@xml/file_paths" />

    </provider>



  </application>



</manifest>

